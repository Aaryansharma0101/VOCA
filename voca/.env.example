# Copy to .env:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ---------------------------------------------------------------------------
# REQUIRED: any OpenAI-compatible endpoint. Nothing in the code names a provider.
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini


# ---------------------------------------------------------------------------
# OPTIONAL: Neo4j. Leave NEO4J_URI empty to use the in-memory graph loaded from
# backend/ingestion/seed. Set it and the app uses Neo4j, falling back cleanly if
# the database is unreachable.
# ---------------------------------------------------------------------------
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# With docker compose:  NEO4J_URI=bolt://localhost:7687  (password 8+ chars)

# ---------------------------------------------------------------------------
# OPTIONAL: Supabase for profile storage. Leave empty to use local SQLite.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL: local sentence-transformers model. Only used if that package is
# installed; normalisation works without it.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000
